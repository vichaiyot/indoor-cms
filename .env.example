# PostgreSQL / PostGIS Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=indoor_cms
POSTGRES_PORT=5432

# Database Connection URL (for NestJS, Prisma, TypeORM, Drizzle, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/indoor_cms?schema=public"

# pgAdmin (Web-based database manager at http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
